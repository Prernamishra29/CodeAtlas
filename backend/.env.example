DATABASE_URL="postgresql://codeatlas:codeatlas@localhost:5432/codeatlas?schema=public"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_DAYS="7"
PORT=3333
CORS_ORIGIN="http://localhost:8080,http://localhost:8081"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
# REDIS_PASSWORD=
WORKER_CONCURRENCY="2"
ANALYSIS_TMP_DIR=""
NODE_ENV="development"

# Public URLs (required for OAuth and password-reset links)
FRONTEND_URL="http://localhost:8080"
API_PUBLIC_URL="http://localhost:3333"

# LLM (optional — docs and chat stay disabled without a key)
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL="gemini-3.6-flash"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# OPENAI_API_KEY=

# Google / GitHub login (optional)
# Create OAuth apps and set callback URLs to:
#   http://localhost:3333/auth/google/callback
#   http://localhost:3333/auth/github/callback
# Production: https://YOUR_API_HOST/auth/google/callback (and github)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Password-reset and analysis emails (optional)
# Use Resend or SMTP. If neither is set, reset links are written to API logs in development.
# MAIL_FROM="CodeAtlas <noreply@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=
# SMTP_PASS=
